# Production Environment Variables for Coolify Deployment
# Copy this file to .env and update the values

# Django Settings
DEBUG=False
SECRET_KEY=your-super-secret-key-here-change-this-in-production
DJANGO_SETTINGS_MODULE=app.settings

# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database_name

# Allowed Hosts (comma-separated)
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com,localhost,127.0.0.1

# CSRF Trusted Origins (comma-separated)
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com,http://localhost

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com,http://localhost:3000

# Mikrotik Configuration
MIKROTIK_URL=http://your-mikrotik-ip
MIKROTIK_USER=your-mikrotik-username
MIKROTIK_PASS=your-mikrotik-password

# Celery Configuration (if using Redis)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Optional: Enable Silk Profiling (set to True for debugging)
ENABLE_SILK=False

# Optional: Enable API Documentation (set to True for Swagger/ReDoc)
ENABLE_DOC=True

# Security Settings
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
USE_X_FORWARDED_HOST=True
