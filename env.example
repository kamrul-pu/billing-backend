# Environment variables for billing-backend
# Copy this to .env and update the values

# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here-change-this-in-production
DJANGO_SETTINGS_MODULE=app.settings

# Database Configuration
DATABASE_URL=sqlite:///db.sqlite3

# Allowed Hosts (comma-separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CSRF Trusted Origins (comma-separated)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://0.0.0.0

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000

# Mikrotik Configuration
MIKROTIK_URL=
MIKROTIK_USER=
MIKROTIK_PASS=kamrul

# Optional: Enable API Documentation
ENABLE_DOC=True
ENABLE_SILK=False
