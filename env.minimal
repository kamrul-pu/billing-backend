# Minimal environment variables for testing
DEBUG=False
SECRET_KEY=test-secret-key-for-development-only-change-in-production
DJANGO_SETTINGS_MODULE=app.settings

# Database - using SQLite for testing
DATABASE_URL=sqlite:///db.sqlite3

# Allowed Hosts
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CSRF Trusted Origins
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://0.0.0.0

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000

# Mikrotik Configuration (optional)
MIKROTIK_URL=http://localhost
MIKROTIK_USER=admin
MIKROTIK_PASS=admin

# Optional
ENABLE_SILK=False
ENABLE_DOC=True
